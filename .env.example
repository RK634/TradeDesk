# Local development defaults only. Never copy these values into a production deployment.
POSTGRES_USER=iem_dev
POSTGRES_PASSWORD=change_this_local_password_use_hex_only
POSTGRES_DB=import_export_dev

APP_NAME="Importer & Exporter Management System"
APP_VERSION=1.0.1
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ALLOW_SELF_REGISTRATION=true

SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
INVITATION_TTL_HOURS=72

# Local private file storage is for development. Production requires an S3-compatible private bucket.
PRIVATE_STORAGE_DIR=/app/.private_storage
MAX_UPLOAD_BYTES=15728640
STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_REGION=eu-central-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

AUTOMATION_ENABLED=true
AUTOMATION_POLL_SECONDS=60

# Frontend uses the same-origin /api/v1 proxy by default.
# VITE_API_BASE_URL=/api/v1
